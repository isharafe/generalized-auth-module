# Spring backend configuration for the local Nuxt demo.
SPRING_PROFILES_ACTIVE=keycloak-demo

AUTHORIZATION_KEYCLOAK_BASE_URL=http://localhost:8081
AUTHORIZATION_KEYCLOAK_REALM=employee-demo
AUTHORIZATION_KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/employee-demo

# Keycloak Admin API service account used by authorization-keycloak.
AUTHORIZATION_KEYCLOAK_CLIENT_ID=authorization-sync-service
AUTHORIZATION_KEYCLOAK_CLIENT_SECRET=authorization-sync-service-demo-secret

# Browser/OIDC client. Its callbacks use the public Nuxt origin.
AUTHORIZATION_KEYCLOAK_LOGIN_CLIENT_ID=employee-demo
AUTHORIZATION_KEYCLOAK_LOGIN_CLIENT_SECRET=employee-demo-secret
