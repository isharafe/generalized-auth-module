{
  "realm": "employee-demo",
  "displayName": "Employee Hierarchy Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "VIEW_SELF",
        "description": "Can view own employee profile"
      },
      {
        "name": "VIEW_TEAM",
        "description": "Can view direct/team employee records"
      },
      {
        "name": "VIEW_DEPARTMENT",
        "description": "Can view department employee records"
      },
      {
        "name": "VIEW_LOCATION",
        "description": "Can view employee records for a location"
      },
      {
        "name": "VIEW_ALL",
        "description": "Can view all employee records"
      },
      {
        "name": "EDIT_SELF",
        "description": "Can edit own employee profile"
      },
      {
        "name": "EDIT_TEAM",
        "description": "Can edit team employee records"
      },
      {
        "name": "EDIT_ALL",
        "description": "Can edit all employee records"
      },
      {
        "name": "APPROVE",
        "description": "Can approve employee-related requests"
      },
      {
        "name": "authorization-demo-viewer",
        "description": "Generalized authorization demo viewer authority"
      },
      {
        "name": "authorization-demo-manager",
        "description": "Generalized authorization demo manager authority"
      }
    ]
  },
  "groups": [
    {
      "name": "Department-Payments"
    },
    {
      "name": "Department-Finance"
    },
    {
      "name": "Department-HR"
    },
    {
      "name": "Location-Singapore"
    },
    {
      "name": "Location-London"
    },
    {
      "name": "Location-Tokyo"
    },
    {
      "name": "Function-Employees",
      "realmRoles": [
        "VIEW_SELF",
        "EDIT_SELF"
      ]
    },
    {
      "name": "Function-Managers",
      "realmRoles": [
        "VIEW_SELF",
        "EDIT_SELF",
        "VIEW_TEAM",
        "EDIT_TEAM",
        "APPROVE"
      ]
    },
    {
      "name": "Function-Department-Heads",
      "realmRoles": [
        "VIEW_SELF",
        "EDIT_SELF",
        "VIEW_TEAM",
        "EDIT_TEAM",
        "VIEW_DEPARTMENT",
        "APPROVE"
      ]
    },
    {
      "name": "Function-HR-Admins",
      "realmRoles": [
        "VIEW_SELF",
        "EDIT_SELF",
        "VIEW_ALL",
        "EDIT_ALL",
        "APPROVE"
      ]
    },
    {
      "name": "Team-Bob"
    },
    {
      "name": "Team-Alice-Department"
    },
    {
      "name": "authorization-demo",
      "subGroups": [
        {
          "name": "viewers"
        },
        {
          "name": "employee-managers"
        },
        {
          "name": "admins"
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/authorization-demo/viewers"
      ],
      "realmRoles": [
        "authorization-demo-viewer"
      ]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/authorization-demo/employee-managers"
      ],
      "realmRoles": [
        "authorization-demo-manager"
      ]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/authorization-demo/admins"
      ]
    },
    {
      "username": "service-account-authorization-sync-service",
      "enabled": true,
      "serviceAccountClientId": "authorization-sync-service",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "employee-demo",
      "name": "Employee Demo Application",
      "description": "Demo client for employee hierarchy authorization",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "employee-demo-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://127.0.0.1:8080/login/oauth2/code/keycloak",
        "http://localhost:3000/login/oauth2/code/keycloak",
        "http://127.0.0.1:3000/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/demo-ui/signed-out##http://127.0.0.1:8080/demo-ui/signed-out##http://localhost:3000/signed-out##http://127.0.0.1:3000/signed-out"
      },
      "protocolMappers": [
        {
          "name": "employee-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employeeId",
            "claim.name": "employeeId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "manager-dn",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "managerDn",
            "claim.name": "managerDn",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "location",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "location",
            "claim.name": "location",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "job-title",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "jobTitle",
            "claim.name": "jobTitle",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "authorizationSettings": {
        "policyEnforcementMode": "ENFORCING",
        "allowRemoteResourceManagement": true,
        "resources": [
          {
            "name": "Own Profile",
            "uri": "/api/me",
            "type": "employee-profile"
          },
          {
            "name": "Team Records",
            "uri": "/api/team/*",
            "type": "employee-records"
          },
          {
            "name": "Department Records",
            "uri": "/api/department/*",
            "type": "employee-records"
          },
          {
            "name": "All Employee Records",
            "uri": "/api/employees/*",
            "type": "employee-records"
          },
          {
            "name": "Approval Queue",
            "uri": "/api/approvals/*",
            "type": "approval-records"
          }
        ],
        "policies": [
          {
            "name": "Employee Policy",
            "description": "Users with VIEW_SELF",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"VIEW_SELF\",\"required\":true}]"
            }
          },
          {
            "name": "Manager Policy",
            "description": "Users with VIEW_TEAM",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"VIEW_TEAM\",\"required\":true}]"
            }
          },
          {
            "name": "Department Head Policy",
            "description": "Users with VIEW_DEPARTMENT",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"VIEW_DEPARTMENT\",\"required\":true}]"
            }
          },
          {
            "name": "HR Admin Policy",
            "description": "Users with VIEW_ALL",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"VIEW_ALL\",\"required\":true}]"
            }
          },
          {
            "name": "Approver Policy",
            "description": "Users with APPROVE",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"APPROVE\",\"required\":true}]"
            }
          },
          {
            "name": "Own Profile Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Own Profile\"]",
              "applyPolicies": "[\"Employee Policy\"]"
            }
          },
          {
            "name": "Team Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Team Records\"]",
              "applyPolicies": "[\"Manager Policy\"]"
            }
          },
          {
            "name": "Department Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Department Records\"]",
              "applyPolicies": "[\"Department Head Policy\"]"
            }
          },
          {
            "name": "All Employee Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"All Employee Records\"]",
              "applyPolicies": "[\"HR Admin Policy\"]"
            }
          },
          {
            "name": "Approval Queue Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Approval Queue\"]",
              "applyPolicies": "[\"Approver Policy\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "edit"
          },
          {
            "name": "approve"
          }
        ]
      }
    },
    {
      "clientId": "authorization-sync-service",
      "name": "Authorization Synchronization Service",
      "description": "Service-account client used by the generalized authorization module to read Keycloak users, groups, and realm roles",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "authorization-sync-service-demo-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    }
  ],
