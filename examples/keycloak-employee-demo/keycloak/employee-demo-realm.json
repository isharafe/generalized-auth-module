      "authorizationSettings": {
        "policyEnforcementMode": "ENFORCING",
        "allowRemoteResourceManagement": true,
        "resources": [
          {
            "name": "Own Profile",
            "uri": "/api/me",
            "type": "employee-profile"
          },
          {
            "name": "Team Records",
            "uri": "/api/team/*",
            "type": "employee-records"
          },
          {
            "name": "Department Records",
            "uri": "/api/department/*",
            "type": "employee-records"
          },
          {
            "name": "All Employee Records",
            "uri": "/api/employees/*",
            "type": "employee-records"
          },
          {
            "name": "Approval Queue",
            "uri": "/api/approvals/*",
            "type": "approval-records"
          }
        ],
        "policies": [
          {
            "name": "Employee Policy",
            "description": "Employees accessing their own profile",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"employee\",\"required\":true}]"
            }
          },
          {
            "name": "Manager Policy",
            "description": "People managers accessing their team",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"people-manager\",\"required\":true}]"
            }
          },
          {
            "name": "Department Head Policy",
            "description": "Department heads accessing their department",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"department-head\",\"required\":true}]"
            }
          },
          {
            "name": "HR Admin Policy",
            "description": "HR administrators accessing all employee records",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"hr-administrator\",\"required\":true}]"
            }
          },
          {
            "name": "Approver Policy",
            "description": "Business approvers accessing approval queues",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"request-approver\",\"required\":true}]"
            }
          },
          {
            "name": "Own Profile Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Own Profile\"]",
              "applyPolicies": "[\"Employee Policy\"]"
            }
          },
          {
            "name": "Team Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Team Records\"]",
              "applyPolicies": "[\"Manager Policy\"]"
            }
          },
          {
            "name": "Department Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Department Records\"]",
              "applyPolicies": "[\"Department Head Policy\"]"
            }
          },
          {
            "name": "All Employee Records Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"All Employee Records\"]",
              "applyPolicies": "[\"HR Admin Policy\"]"
            }
          },
          {
            "name": "Approval Queue Permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Approval Queue\"]",
              "applyPolicies": "[\"Approver Policy\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "edit"
          },
          {
            "name": "approve"
          }
        ]
